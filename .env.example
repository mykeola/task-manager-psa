# PSA Task Manager Environment Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/task_manager_psa

# Security & Authentication (Change in production)
JWT_SECRET=psa_super_secret_jwt_access_token_key_2026_production_grade
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=psa_super_secret_jwt_refresh_token_key_2026_secure
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
